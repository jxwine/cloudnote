{
  "name": "cloudnote-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "云笔记同步服务：REST + WebSocket 实时同步",
  "main": "src/index.js",
  "scripts": {
    "start": "node --no-warnings src/index.js",
