# 复制成 server/.env 再改。部署时 deploy/setup.sh 会自动生成并填好随机密钥。

# 登录凭证的签名密钥。务必换成随机串，别用示例值。
# 生成：node -p "require('crypto').randomBytes(48).toString('base64url')"
CLOUDNOTE_SECRET=change-me

PORT=4471
# 只监听回环，外网统一走 Nginx
HOST=127.0.0.1

# 数据放哪儿。备份就备份这两个路径。
CLOUDNOTE_DB=./data/cloudnote.db
CLOUDNOTE_UPLOADS=./data/uploads

# 登录限流：只统计失败，成功一次清零
CLOUDNOTE_AUTH_LIMIT_ID=5
CLOUDNOTE_AUTH_LIMIT_IP=30
